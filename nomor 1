    <!-- SCRIPT JAVASCRIPT & LOCALSTORAGE -->
    <script>
        // STATE UTAMA (LocalStorage Persist)
        let cart = [];
        let reservations = JSON.parse(localStorage.getItem('delvira_res')) || [];
        let inventory = JSON.parse(localStorage.getItem('delvira_inv')) || [
            { name: 'Gel Polish Red', category: 'Kuteks', qty: 5 },
            { name: 'Kapas Bebas Serat', category: 'Bahan', qty: 2 }
        ];
        let expenses = JSON.parse(localStorage.getItem('delvira_exp')) || [];
        let totalIncome = Number(localStorage.getItem('delvira_income')) || 0;

        function switchTab(tabId) {
            const pages = ['dashboard', 'pos', 'pricelist', 'reservation', 'inventory', 'expenses', 'customers', 'reports'];
            pages.forEach(p => {
                document.getElementById('page-' + p).classList.add('hidden');
                document.getElementById('nav-' + p)?.classList.remove('bg-pink-800', 'text-white');
            });
            document.getElementById('page-' + tabId).classList.remove('hidden');
            document.getElementById('nav-' + tabId)?.classList.add('bg-pink-800', 'text-white');
        }

        function toggleModal(id) {
            document.getElementById(id).classList.toggle('hidden');
        }

        // KASIR & STRUK
        function addToCart(name, price) {
            cart.push({ name, price });
            updateCartUI();
        }

        function updateCartUI() {
            const cartContainer = document.getElementById('cartItems');
            const subtotal = cart.reduce((sum, item) => sum + item.price, 0);
            const dp = Number(document.getElementById('posDP').value) || 0;
            const total = Math.max(0, subtotal - dp);

            if(cart.length === 0) {
                cartContainer.innerHTML = 'Keranjang kosong.';
            } else {
                cartContainer.innerHTML = cart.map(i => `<div class="flex justify-between py-1"><span>${i.name}</span><span class="font-semibold">Rp ${i.price.toLocaleString()}</span></div>`).join('');
            }

            document.getElementById('cartSubtotal').innerText = 'Rp ' + subtotal.toLocaleString();
            document.getElementById('cartTotal').innerText = 'Rp ' + total.toLocaleString();
        }

        function processPayment() {
            const customer = document.getElementById('posCustomerName').value || 'Pelanggan Umum';
            const subtotal = cart.reduce((sum, item) => sum + item.price, 0);
            const dp = Number(document.getElementById('posDP').value) || 0;
            const total = Math.max(0, subtotal - dp);

            if(cart.length === 0) return alert('Pilih layanan terlebih dahulu!');

            // Update Total Income
            totalIncome += total;
            localStorage.setItem('delvira_income', totalIncome);

            // Tampilkan Struk Bukti Pembayaran
            document.getElementById('recCustomer').innerText = customer;
            document.getElementById('recDate').innerText = new Date().toLocaleDateString('id-ID');
            document.getElementById('recItems').innerHTML = cart.map(i => `<div class="flex justify-between"><span>${i.name}</span><span>Rp ${i.price.toLocaleString()}</span></div>`).join('');
            document.getElementById('recSubtotal').innerText = 'Rp ' + subtotal.toLocaleString();
            document.getElementById('recDP').innerText = 'Rp ' + dp.toLocaleString();
            document.getElementById('recTotal').innerText = 'Rp ' + total.toLocaleString();

            toggleModal('modalReceipt');
            
            // Reset Form
            cart = [];
            document.getElementById('posCustomerName').value = '';
            document.getElementById('posDP').value = '0';
            updateCartUI();
            updateDashboard();
        }

        // DOWNLOAD STRUK SEBAGAI GAMBAR/PDF
        function downloadReceipt() {
            const receiptArea = document.getElementById('receiptContent');
            html2canvas(receiptArea).then(canvas => {
                const link = document.createElement('a');
                link.download = `Struk_DelviraNails_${Date.now()}.png`;
                link.href = canvas.toDataURL();
                link.click();
            });
        }

        // RESERVASI
        function addReservation(e) {
            e.preventDefault();
            const newRes = {
                id: Date.now(),
                name: document.getElementById('resName').value,
                date: document.getElementById('resDate').value,
                service: document.getElementById('resService').value,
                dp: Number(document.getElementById('resDP').value) || 0
            };
            reservations.push(newRes);
            localStorage.setItem('delvira_res', JSON.stringify(reservations));
            renderReservations();
            e.target.reset();
        }

        function renderReservations() {
            const tbody = document.getElementById('resTableBody');
            if(reservations.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center p-4 text-slate-400">Belum ada reservasi.</td></tr>';
            } else {
                tbody.innerHTML = reservations.map(r => `
                    <tr>
                        <td class="p-2 font-bold">${r.name}</td>
                        <td class="p-2">${new Date(r.date).toLocaleString('id-ID')}</td>
                        <td class="p-2">${r.service}</td>
                        <td class="p-2 text-emerald-600 font-bold">Rp ${r.dp.toLocaleString()}</td>
                        <td class="p-2"><button onclick="deleteRes(${r.id})" class="text-red-500 font-bold">Hapus</button></td>
                    </tr>
                `).join('');
            }
        }

        function deleteRes(id) {
            reservations = reservations.filter(r => r.id !== id);
            localStorage.setItem('delvira_res', JSON.stringify(reservations));
            renderReservations();
        }

        // STOK INVENTORY
        function addInventoryItem(e) {
            e.preventDefault();
            const item = {
                name: document.getElementById('invName').value,
                category: document.getElementById('invCategory').value,
                qty: Number(document.getElementById('invQty').value)
            };
            inventory.push(item);
            localStorage.setItem('delvira_inv', JSON.stringify(inventory));
            renderInventory();
            toggleModal('modalInventory');
            e.target.reset();
        }

        function renderInventory() {
            const tbody = document.getElementById('inventoryTable');
            tbody.innerHTML = inventory.map((item, index) => `
                <tr>
                    <td class="p-3 font-semibold">${item.name}</td>
                    <td class="p-3 text-slate-500">${item.category}</td>
                    <td class="p-3 font-bold">${item.qty}</td>
                    <td class="p-3">
                        <span class="px-2 py-1 rounded-full text-[10px] font-bold ${item.qty <= 3 ? 'bg-red-100 text-red-600' : 'bg-emerald-100 text-emerald-600'}">
                            ${item.qty <= 3 ? 'Menipis' : 'Cukup'}
                        </span>
                    </td>
                    <td class="p-3"><button onclick="deleteInv(${index})" class="text-red-500"><i class="fa-solid fa-trash"></i></button></td>
                </tr>
            `).join('');
        }

        function deleteInv(index) {
            inventory.splice(index, 1);
            localStorage.setItem('delvira_inv', JSON.stringify(inventory));
            renderInventory();
        }

        // PENGELUARAN & NOTA
        function addExpense(e) {
            e.preventDefault();
            const fileInput = document.getElementById('expPhoto');
            const file = fileInput.files[0];

            if(file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    saveExpenseData(evt.target.result);
                };
                reader.readAsDataURL(file);
            } else {
                saveExpenseData(null);
            }
        }

        function saveExpenseData(photoUrl) {
            const item = {
                title: document.getElementById('expTitle').value,
                amount: Number(document.getElementById('expAmount').value),
                photo: photoUrl
            };
            expenses.push(item);
            localStorage.setItem('delvira_exp', JSON.stringify(expenses));
            renderExpenses();
            document.getElementById('expTitle').value = '';
            document.getElementById('expAmount').value = '';
            document.getElementById('expPhoto').value = '';
        }

        function renderExpenses() {
            const tbody = document.getElementById('expensesTable');
            tbody.innerHTML = expenses.map(e => `
                <tr>
                    <td class="p-2 font-semibold">${e.title}</td>
                    <td class="p-2 text-red-500 font-bold">Rp ${e.amount.toLocaleString()}</td>
                    <td class="p-2">
                        ${e.photo ? `<a href="${e.photo}" target="_blank" class="text-blue-500 underline font-bold">Lihat Nota</a>` : '-'}
                    </td>
                </tr>
            `).join('');
        }

        function updateDashboard() {
            document.getElementById('dash-income-today').innerText = 'Rp ' + totalIncome.toLocaleString();
            
            const totalExp = expenses.reduce((sum, item) => sum + item.amount, 0);
            document.getElementById('dash-expenses').innerText = 'Rp ' + totalExp.toLocaleString();

            document.getElementById('dash-res-count').innerText = reservations.length;
            
            const lowStock = inventory.filter(i => i.qty <= 3).length;
            document.getElementById('dash-stock-alert').innerText = lowStock + ' Item';
        }

        // INIT ON LOAD
        window.onload = function() {
            renderReservations();
            renderInventory();
            renderExpenses();
            updateDashboard();

            // Charts
            new Chart(document.getElementById('chartIncome').getContext('2d'), {
                type: 'line',
                data: {
                    labels: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Ming'],
                    datasets: [{ label: 'Pendapatan', data: [0, 0, 0, 0, 0, totalIncome, 0], borderColor: '#db2777', tension: 0.3 }]
                }
            });

            new Chart(document.getElementById('chartServices').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Hand Care', 'Gel Polish', 'Design', 'Removal'],
                    datasets: [{ data: [1, 3, 2, 1], backgroundColor: ['#f472b6', '#db2777', '#9d174d', '#cbd5e1'] }]
                }
            });
        };
    </script>
</body>
</html>
